<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
    eqEventsFrame.xml
    Realistic Equestrian's Events tab inside RLRM's menu.

    Left: open events (or, toggled, your results). Right: your horses for the selected event,
    with their chance of success, what the event would teach them and whether they can enter,
    and under that a panel for the selected horse. Profiles are RLRM's (rlMenu_*) and the base
    game's (fs25_*), so the tab looks like the rest of the menu; this file defines none.
    Content width follows RLRM's frames: 1540px inside fs25_menuContainer.
-->
<GUI name="EqEventsFrame">
    <GuiElement profile="fs25_menuContainer">

        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" id="headerIcon" imageSliceId="eqMenu.events"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="headerTitle" text="$l10n_eq_ui_title"/>
        </GuiElement>

        <!-- Events table -->
        <GuiElement profile="rlMenu_container" id="eventsHeader" position="20px -120px" size="1000px 40px">
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="10px 0px"  size="270px 40px" text="$l10n_eq_ui_col_event"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="290px 0px" size="130px 40px" text="$l10n_eq_ui_col_type"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="430px 0px" size="110px 40px" text="$l10n_eq_ui_col_level"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="545px 0px" size="105px 40px" text="$l10n_eq_ui_col_going"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="650px 0px" size="80px 40px"  text="$l10n_eq_ui_col_fee"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="735px 0px" size="100px 40px" text="$l10n_eq_ui_col_prize"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="850px 0px" size="150px 40px" text="$l10n_eq_ui_col_yours"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px"/>
        </GuiElement>

        <GuiElement profile="rlMenu_container" id="eventsBox" position="20px -165px" size="1020px 700px">
            <SmoothList profile="rlMenu_tableList" id="eventsList" position="0px 0px" size="1000px 700px">
                <ListItem profile="rlMenu_tableListItem" name="eventRowTemplate" size="1000px 48px">
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="10px 0px"  size="270px 48px" name="title" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="290px 0px" size="130px 48px" name="type" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="430px 0px" size="110px 48px" name="level" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="545px 0px" size="105px 48px" name="going"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="650px 0px" size="80px 48px"  name="fee"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="735px 0px" size="100px 48px" name="prize"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="850px 0px" size="150px 48px" name="yours" textLayoutMode="scrolling"/>
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="-5px 0px" size="12px 700px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 692px" dataElementId="eventsList"/>
            </ThreePartBitmap>
        </GuiElement>

        <!-- Results table (shown instead of the events table) -->
        <GuiElement profile="rlMenu_container" id="resultsHeader" position="20px -120px" size="1000px 40px" visible="false">
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="10px 0px"  size="110px 40px" text="$l10n_eq_ui_col_day"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="130px 0px" size="370px 40px" text="$l10n_eq_ui_col_event"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="510px 0px" size="190px 40px" text="$l10n_eq_ui_col_horse"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="710px 0px" size="150px 40px" text="$l10n_eq_ui_col_result"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="870px 0px" size="120px 40px" text="$l10n_eq_ui_col_prize"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px"/>
        </GuiElement>

        <GuiElement profile="rlMenu_container" id="resultsBox" position="20px -165px" size="1020px 700px" visible="false">
            <SmoothList profile="rlMenu_tableList" id="resultsList" position="0px 0px" size="1000px 700px">
                <ListItem profile="rlMenu_tableListItem" name="resultRowTemplate" size="1000px 48px">
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="10px 0px"  size="110px 48px" name="day"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="130px 0px" size="370px 48px" name="title" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="510px 0px" size="190px 48px" name="horse" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="710px 0px" size="150px 48px" name="result"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="870px 0px" size="120px 48px" name="prize"/>
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="-5px 0px" size="12px 700px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 692px" dataElementId="resultsList"/>
            </ThreePartBitmap>
        </GuiElement>

        <!-- Your horses for the selected event -->
        <GuiElement profile="rlMenu_container" id="horsesHeader" position="1060px -120px" size="500px 40px">
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="10px 0px"  size="140px 40px" text="$l10n_eq_ui_col_horse"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="155px 0px" size="105px 40px" text="$l10n_eq_ui_col_success"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="265px 0px" size="85px 40px"  text="$l10n_eq_ui_col_training"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="355px 0px" size="140px 40px" text="$l10n_eq_ui_col_status"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px"/>
        </GuiElement>

        <GuiElement profile="rlMenu_container" id="horsesBox" position="1060px -165px" size="520px 384px">
            <SmoothList profile="rlMenu_tableList" id="horsesList" position="0px 0px" size="500px 384px">
                <ListItem profile="rlMenu_tableListItem" name="horseRowTemplate" size="500px 48px">
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="10px 0px"  size="140px 48px" name="name" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="155px 0px" size="105px 48px" name="success"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="265px 0px" size="85px 48px"  name="training"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="355px 0px" size="140px 48px" name="status" textLayoutMode="scrolling"/>
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="-5px 0px" size="12px 384px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 376px" dataElementId="horsesList"/>
            </ThreePartBitmap>
        </GuiElement>

        <!-- The selected horse, under its table: label left, value at 200px. Fixed rows of plain
             text (the table's own cell profiles), so nothing depends on a layout pass. -->
        <GuiElement profile="rlMenu_container" id="horsePanel" position="1070px -565px" size="490px 310px">
            <GuiElement profile="rlMenu_container" position="0px 0px" size="490px 36px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 36px" id="panelName" textSize="22px" textBold="true" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 36px" id="panelAge" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -36px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" text="$l10n_eq_ui_col_status" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelStatus" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -74px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="panelStatLabel[1]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelStatValue[1]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -102px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="panelStatLabel[2]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelStatValue[2]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -130px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="panelStatLabel[3]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelStatValue[3]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -158px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="panelStatLabel[4]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelStatValue[4]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -196px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" text="$l10n_eq_ui_trainingBenefit" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelTraining" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -224px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" text="$l10n_eq_ui_col_success" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelSuccess" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -252px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="panelTransportLabel" text="$l10n_eq_ui_transportLabel" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelTransport" textLayoutMode="scrolling"/>
            </GuiElement>
        </GuiElement>

        <Text profile="fs25_settingsMultiTextOptionTitle" id="emptyState"
              position="20px -450px" size="1000px 40px" textAlignment="center" visible="false"/>

        <Text profile="fs25_settingsMultiTextOptionTitle" id="horsesEmptyState"
              position="1060px -330px" size="500px 40px" textAlignment="center" visible="false"/>

        <Bitmap profile="rlMenu_tableSummary" id="summaryRow" position="20px -880px" size="1540px 40px">
            <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="1540px 40px" id="summaryText"/>
        </Bitmap>

    </GuiElement>
</GUI>
