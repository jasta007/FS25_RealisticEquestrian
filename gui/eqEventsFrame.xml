<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
    eqEventsFrame.xml
    Realistic Equestrian's Events tab inside RLRM's menu.

    Left: open events (or, toggled, your results). Right: your horses for the selected event,
    with their rating and whether they can enter. Profiles are RLRM's (rlMenu_*) and the base
    game's (fs25_*), so the tab looks like the rest of the menu; this file defines none.
    Content width follows RLRM's frames: 1540px inside fs25_menuContainer.
-->
<GUI name="EqEventsFrame">
    <GuiElement profile="fs25_menuContainer">

        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" imageSliceId="eqMenu.events"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="headerTitle" text="$l10n_eq_ui_title"/>
        </GuiElement>

        <!-- Events table -->
        <Bitmap profile="rlMenu_tableList" id="eventsHeader" position="20px -120px" size="1000px 40px">
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="10px 0px"  size="250px 40px" text="$l10n_eq_ui_col_event"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="270px 0px" size="120px 40px" text="$l10n_eq_ui_col_level"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="400px 0px" size="110px 40px" text="$l10n_eq_ui_col_going"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="520px 0px" size="100px 40px" text="$l10n_eq_ui_col_when"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="620px 0px" size="90px 40px"  text="$l10n_eq_ui_col_fee"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="720px 0px" size="110px 40px" text="$l10n_eq_ui_col_prize"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="845px 0px" size="155px 40px" text="$l10n_eq_ui_col_yours"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px"/>
        </Bitmap>

        <GuiElement profile="rlMenu_container" id="eventsBox" position="20px -165px" size="1020px 700px">
            <SmoothList profile="rlMenu_tableList" id="eventsList" position="0px 0px" size="1000px 700px">
                <ListItem profile="rlMenu_tableListItem" name="eventRowTemplate" size="1000px 48px">
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="10px 0px"  size="250px 48px" name="title" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="270px 0px" size="120px 48px" name="level" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="400px 0px" size="110px 48px" name="going"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="520px 0px" size="100px 48px" name="when"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="620px 0px" size="90px 48px"  name="fee"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="720px 0px" size="110px 48px" name="prize"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="845px 0px" size="155px 48px" name="yours" textLayoutMode="scrolling"/>
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="-5px 0px" size="12px 700px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 692px" dataElementId="eventsList"/>
            </ThreePartBitmap>
        </GuiElement>

        <!-- Results table (shown instead of the events table) -->
        <Bitmap profile="rlMenu_tableList" id="resultsHeader" position="20px -120px" size="1000px 40px" visible="false">
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="10px 0px"  size="110px 40px" text="$l10n_eq_ui_col_day"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="130px 0px" size="370px 40px" text="$l10n_eq_ui_col_event"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="510px 0px" size="190px 40px" text="$l10n_eq_ui_col_horse"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="710px 0px" size="150px 40px" text="$l10n_eq_ui_col_result"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="870px 0px" size="120px 40px" text="$l10n_eq_ui_col_prize"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px"/>
        </Bitmap>

        <GuiElement profile="rlMenu_container" id="resultsBox" position="20px -165px" size="1020px 700px" visible="false">
            <SmoothList profile="rlMenu_tableList" id="resultsList" position="0px 0px" size="1000px 700px">
                <ListItem profile="rlMenu_tableListItem" name="resultRowTemplate" size="1000px 48px">
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="10px 0px"  size="110px 48px" name="day"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="130px 0px" size="370px 48px" name="title" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="510px 0px" size="190px 48px" name="horse" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="710px 0px" size="150px 48px" name="result"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="870px 0px" size="120px 48px" name="prize"/>
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="-5px 0px" size="12px 700px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 692px" dataElementId="resultsList"/>
            </ThreePartBitmap>
        </GuiElement>

        <!-- Your horses for the selected event -->
        <Bitmap profile="rlMenu_tableList" id="horsesHeader" position="1060px -120px" size="500px 40px">
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="10px 0px"  size="170px 40px" text="$l10n_eq_ui_col_horse"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="190px 0px" size="70px 40px"  text="$l10n_eq_ui_col_age"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="270px 0px" size="70px 40px"  text="$l10n_eq_ui_col_rating"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="360px 0px" size="140px 40px" text="$l10n_eq_ui_col_status"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px"/>
        </Bitmap>

        <GuiElement profile="rlMenu_container" id="horsesBox" position="1060px -165px" size="520px 700px">
            <SmoothList profile="rlMenu_tableList" id="horsesList" position="0px 0px" size="500px 700px">
                <ListItem profile="rlMenu_tableListItem" name="horseRowTemplate" size="500px 48px">
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="10px 0px"  size="170px 48px" name="name" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="190px 0px" size="70px 48px"  name="age"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="270px 0px" size="70px 48px"  name="rating"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="360px 0px" size="140px 48px" name="status" textLayoutMode="scrolling"/>
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="-5px 0px" size="12px 700px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 692px" dataElementId="horsesList"/>
            </ThreePartBitmap>
        </GuiElement>

        <Text profile="fs25_settingsMultiTextOptionTitle" id="emptyState"
              position="20px -450px" size="1000px 40px" textAlignment="center" visible="false"/>

        <Text profile="fs25_settingsMultiTextOptionTitle" id="horsesEmptyState"
              position="1060px -450px" size="500px 40px" textAlignment="center" visible="false"/>

        <Bitmap profile="rlMenu_tableSummary" id="summaryRow" position="20px -880px" size="1540px 40px">
            <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="1540px 40px" id="summaryText"/>
        </Bitmap>

    </GuiElement>
</GUI>
