            <GuiElement profile="rlMenu_container" position="0px -34px" size="490px 30px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 30px" id="hostLabel[2]" textLayoutMode="scrolling"/>
