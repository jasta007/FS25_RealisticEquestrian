                <Slider profile="fs25_listSlider" size="6px 282px" dataElementId="hostChecksList"/>
            </ThreePartBitmap>
        </GuiElement>

        <!-- The month to book: a picker, shown while nothing is booked -->
        <GuiElement profile="rlMenu_container" id="hostMonthBox" position="1070px -463px" size="490px 44px" visible="false">
            <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 44px" text="$l10n_eq_host_label_month"/>
            <!-- The settings profile anchors on the right, so 0px puts it flush right (200px to 490px) -->
            <MultiTextOption profile="fs25_settingsMultiTextOption" id="hostMonthOption" position="0px 0px" size="290px 44px"
                             onClick="onClickHostMonth"/>
        </GuiElement>

        <!-- Your booking and the selected event's numbers: label left, value at 200px -->
        <GuiElement profile="rlMenu_container" id="hostPanel" position="1070px -517px" size="490px 340px" visible="false">
            <GuiElement profile="rlMenu_container" position="0px -0px" size="490px 30px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 30px" id="hostLabel[1]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 30px" id="hostValue[1]" textLayoutMode="scrolling"/>
