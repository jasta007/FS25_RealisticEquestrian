<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
    eqEventsFrame.xml
    Realistic Equestrian's Events tab inside RLRM's menu.

    Four tabs, in the style of RLRM's Settings page (the same base game profiles).
    Upcoming events: open events on the left; right, your horses for the selected event, with
    their chance of success, what the event would teach them and whether they can enter, and
    under that a panel for the selected horse.
    Results: your horses on the right with their career under the list; left, the selected
    horse's last events, each a title row and a few lines on how it went.
    Host: every event you could host, its requirements and your booking (EqHostView).
    Sponsors: your sponsor and this year's offers on the left; right, the selected one's logo,
    demands and rewards, and what stops you signing (EqSponsorView). Profiles are RLRM's (rlMenu_*) and the base
    game's (fs25_*), so the tab looks like the rest of the menu; this file defines none.
    Content width follows RLRM's frames: 1540px inside fs25_menuContainer.

    Part of Realistic Equestrian by Jasta007.
-->
<GUI name="EqEventsFrame">
    <GuiElement profile="fs25_menuContainer">

        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" id="headerIcon" imageSliceId="eqMenu.events"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="headerTitle" text="$l10n_eq_ui_title"/>
        </GuiElement>

        <!-- Tab bar, as on RLRM's Settings page -->
        <BoxLayout profile="fs25_subCategorySelectorTabbedBox" id="subCategoryBox">
            <Button profile="fs25_subCategorySelectorTabbedTab" id="subCategoryTabs[1]"
                    text="$l10n_eq_ui_tab_upcoming" onClick="onClickUpcomingTab">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" id="subCategoryTabs[2]"
                    text="$l10n_eq_ui_tab_results" onClick="onClickResultsTab">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" id="subCategoryTabs[3]"
                    text="$l10n_eq_ui_tab_host" onClick="onClickHostTab">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" id="subCategoryTabs[4]"
                    text="$l10n_eq_ui_tab_sponsors" onClick="onClickSponsorsTab">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
        </BoxLayout>
        <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="0px -57px"/>
        <MultiTextOption profile="fs25_subCategorySelectorTabbed" id="subCategoryPaging"
                         position="0px -10px" onClick="onSubCategoryChanged"/>

        <!-- Events table -->
        <GuiElement profile="rlMenu_container" id="eventsHeader" position="20px -120px" size="1000px 40px">
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="10px 0px"  size="215px 40px" text="$l10n_eq_ui_col_event"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="235px 0px" size="125px 40px" text="$l10n_eq_ui_col_type"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="370px 0px" size="110px 40px" text="$l10n_eq_ui_col_level"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="485px 0px" size="100px 40px" text="$l10n_eq_ui_col_going"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="590px 0px" size="80px 40px"  text="$l10n_eq_ui_col_risk"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="670px 0px" size="80px 40px"  text="$l10n_eq_ui_col_fee"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="755px 0px" size="95px 40px"  text="$l10n_eq_ui_col_prize"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="860px 0px" size="140px 40px" text="$l10n_eq_ui_col_yours"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px"/>
        </GuiElement>

        <GuiElement profile="rlMenu_container" id="eventsBox" position="20px -165px" size="1020px 700px">
            <SmoothList profile="rlMenu_tableList" id="eventsList" position="0px 0px" size="1000px 700px">
                <ListItem profile="rlMenu_tableListItem" name="eventRowTemplate" size="1000px 48px">
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="10px 0px"  size="215px 48px" name="title" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="235px 0px" size="125px 48px" name="type" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="370px 0px" size="110px 48px" name="level" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="485px 0px" size="100px 48px" name="going"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="590px 0px" size="80px 48px"  name="risk" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="670px 0px" size="80px 48px"  name="fee"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="755px 0px" size="95px 48px"  name="prize"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="860px 0px" size="140px 48px" name="yours" textLayoutMode="scrolling"/>
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="-5px 0px" size="12px 700px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 692px" dataElementId="eventsList"/>
            </ThreePartBitmap>
        </GuiElement>

        <!-- Results: the selected horse's last events (shown instead of the events table) -->
        <GuiElement profile="rlMenu_container" id="resultsHeader" position="20px -120px" size="1000px 40px" visible="false">
            <Text profile="rlMenu_tableHeaderLeftAligned" position="10px 0px" size="980px 40px" id="resultsHeaderText" text="$l10n_eq_ui_col_result" textLayoutMode="scrolling"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px"/>
        </GuiElement>

        <GuiElement profile="rlMenu_container" id="resultsBox" position="20px -165px" size="1020px 700px" visible="false">
            <SmoothList profile="rlMenu_tableList" id="resultsList" position="0px 0px" size="1000px 700px">
                <ListItem profile="rlMenu_tableListItem" name="resultRowTemplate" size="1000px 40px">
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="10px 0px" size="980px 40px" name="title" textBold="true" textLayoutMode="scrolling"/>
                    <!-- A story line in runs, plain and bold, laid end to end by EqEventsFrame.setRuns -->
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="40px 0px" size="950px 40px" name="line1"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="40px 0px" size="950px 40px" name="line2"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="40px 0px" size="950px 40px" name="line3"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="40px 0px" size="950px 40px" name="line4"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="40px 0px" size="950px 40px" name="line5"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="40px 0px" size="950px 40px" name="line6"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="40px 0px" size="950px 40px" name="line7"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="40px 0px" size="950px 40px" name="line8"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="40px 0px" size="950px 40px" name="line9"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="40px 0px" size="950px 40px" name="line10"/>
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="-5px 0px" size="12px 700px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 692px" dataElementId="resultsList"/>
            </ThreePartBitmap>
        </GuiElement>

        <!-- Results: your horses' columns over the same horse list -->
        <GuiElement profile="rlMenu_container" id="resultHorsesHeader" position="1060px -120px" size="500px 40px" visible="false">
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="10px 0px"  size="140px 40px" text="$l10n_eq_ui_col_horse"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="155px 0px" size="105px 40px" text="$l10n_eq_ui_col_starts"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="265px 0px" size="85px 40px"  text="$l10n_eq_ui_col_wins"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="355px 0px" size="140px 40px" text="$l10n_eq_ui_col_lastResult" textLayoutMode="scrolling"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px"/>
        </GuiElement>

        <!-- Your horses for the selected event -->
        <GuiElement profile="rlMenu_container" id="horsesHeader" position="1060px -120px" size="500px 40px">
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="10px 0px"  size="140px 40px" text="$l10n_eq_ui_col_horse"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="155px 0px" size="105px 40px" text="$l10n_eq_ui_col_success"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="265px 0px" size="85px 40px"  text="$l10n_eq_ui_col_training"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="355px 0px" size="140px 40px" text="$l10n_eq_ui_col_status"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px"/>
        </GuiElement>

        <GuiElement profile="rlMenu_container" id="horsesBox" position="1060px -165px" size="520px 336px">
            <SmoothList profile="rlMenu_tableList" id="horsesList" position="0px 0px" size="500px 336px">
                <ListItem profile="rlMenu_tableListItem" name="horseRowTemplate" size="500px 48px">
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="10px 0px"  size="140px 48px" name="name" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="155px 0px" size="105px 48px" name="success"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="265px 0px" size="85px 48px"  name="training"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="355px 0px" size="140px 48px" name="status" textLayoutMode="scrolling"/>
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="-5px 0px" size="12px 336px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 328px" dataElementId="horsesList"/>
            </ThreePartBitmap>
        </GuiElement>

        <!-- The selected horse, under its table: label left, value at 200px. Fixed rows of plain
             text (the table's own cell profiles), so nothing depends on a layout pass. -->
        <GuiElement profile="rlMenu_container" id="horsePanel" position="1070px -517px" size="490px 340px">
            <GuiElement profile="rlMenu_container" position="0px 0px" size="490px 36px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 36px" id="panelName" textSize="22px" textBold="true" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 36px" id="panelAge" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -36px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" text="$l10n_eq_ui_col_status" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelStatus" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -74px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="panelStatLabel[1]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelStatValue[1]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -102px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="panelStatLabel[2]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelStatValue[2]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -130px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="panelStatLabel[3]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelStatValue[3]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -158px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="panelStatLabel[4]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelStatValue[4]" textLayoutMode="scrolling"/>
            </GuiElement>
            <!-- Last row (under Specialty when that row is there), so it sits apart from the rest. -->
            <GuiElement profile="rlMenu_container" position="0px -308px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" text="$l10n_eq_ui_injuryRisk" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelRisk" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -196px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" text="$l10n_eq_ui_trainingBenefit" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelTraining" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -224px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" text="$l10n_eq_ui_col_success" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelSuccess" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -252px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="panelTransportLabel" text="$l10n_eq_ui_transportLabel" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelTransport" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -280px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" text="$l10n_eq_specialty_title" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelSpecialty" textLayoutMode="scrolling"/>
            </GuiElement>
        </GuiElement>

        <!-- Results: the selected horse's career, in the same place as the entry panel -->
        <GuiElement profile="rlMenu_container" id="careerPanel" position="1070px -517px" size="490px 340px" visible="false">
            <GuiElement profile="rlMenu_container" position="0px 0px" size="490px 36px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 36px" id="careerName" textSize="22px" textBold="true" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 36px" id="careerAge" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -46px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="careerStatLabel[1]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="careerStatValue[1]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -74px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="careerStatLabel[2]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="careerStatValue[2]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -102px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="careerStatLabel[3]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="careerStatValue[3]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -130px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="careerStatLabel[4]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="careerStatValue[4]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -168px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" text="$l10n_eq_ui_career_starts" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="careerStarts" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -196px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" text="$l10n_eq_ui_career_record" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="careerRecord" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -224px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" text="$l10n_eq_ui_career_earnings" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="careerEarnings" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -252px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" text="$l10n_eq_ui_career_eliminations" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="careerEliminations" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -280px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" text="$l10n_eq_specialty_title" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="careerSpecialty" textLayoutMode="scrolling"/>
            </GuiElement>
        </GuiElement>

        <!-- Host: every event you could host on the left; the selected one's requirements right,
             your booking under them -->
        <GuiElement profile="rlMenu_container" id="hostHeader" position="20px -120px" size="1000px 40px" visible="false">
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="10px 0px"  size="330px 40px" text="$l10n_eq_host_col_event"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="350px 0px" size="200px 40px" text="$l10n_eq_host_col_ready"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="555px 0px" size="130px 40px" text="$l10n_eq_host_col_popularity"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="690px 0px" size="145px 40px" text="$l10n_eq_host_col_setup"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="840px 0px" size="150px 40px" text="$l10n_eq_host_col_takings"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px"/>
        </GuiElement>

        <GuiElement profile="rlMenu_container" id="hostBox" position="20px -165px" size="1020px 700px" visible="false">
            <SmoothList profile="rlMenu_tableList" id="hostList" position="0px 0px" size="1000px 700px">
                <ListItem profile="rlMenu_tableListItem" name="hostRowTemplate" size="1000px 48px">
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="10px 0px"  size="330px 48px" name="title" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="350px 0px" size="200px 48px" name="ready" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="555px 0px" size="130px 48px" name="popularity"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="690px 0px" size="145px 48px" name="setup"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="840px 0px" size="150px 48px" name="takings"/>
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="-5px 0px" size="12px 700px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 692px" dataElementId="hostList"/>
            </ThreePartBitmap>
        </GuiElement>

        <GuiElement profile="rlMenu_container" id="hostChecksHeader" position="1060px -120px" size="500px 40px" visible="false">
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="10px 0px"  size="220px 40px" text="$l10n_eq_host_col_check"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="235px 0px" size="125px 40px" text="$l10n_eq_host_col_have"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="365px 0px" size="125px 40px" text="$l10n_eq_host_col_need"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px"/>
        </GuiElement>

        <GuiElement profile="rlMenu_container" id="hostChecksBox" position="1060px -165px" size="520px 290px" visible="false">
            <SmoothList profile="rlMenu_tableList" id="hostChecksList" position="0px 0px" size="500px 290px">
                <ListItem profile="rlMenu_tableListItem" name="hostCheckRowTemplate" size="500px 42px">
