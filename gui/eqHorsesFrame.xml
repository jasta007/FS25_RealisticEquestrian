<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
    eqHorsesFrame.xml
    The Horses tab of our own menu (EqMenu), for games without Realistic Livestock: the farm's
    horses in a table on the left, the selected one's skills, potential, form and career on the
    right, as the look-at Skills box shows them. Laid out like the Staff tab.

    Part of Realistic Equestrian by Jasta007.
-->
<GUI name="EqHorsesFrame">
    <GuiElement profile="fs25_menuContainer">

        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" id="headerIcon" imageSliceId="eqMenu.horses"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="headerTitle" text="$l10n_eq_horses_title"/>
        </GuiElement>

        <GuiElement profile="rlMenu_container" id="horsesHeader" position="20px -70px" size="1000px 40px">
            <Text profile="rlMenu_tableHeaderLeftAligned" position="10px 0px" size="190px 40px" text="$l10n_eq_horses_col_name"/>
            <Text profile="rlMenu_tableHeaderLeftAligned" position="205px 0px" size="160px 40px" text="$l10n_eq_role_title"/>
            <Text profile="rlMenu_tableHeaderLeftAligned" position="370px 0px" size="90px 40px" text="$l10n_eq_horses_col_age"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="465px 0px" size="85px 40px" text="$l10n_eq_stat_stamina"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="555px 0px" size="85px 40px" text="$l10n_eq_stat_speed"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="645px 0px" size="85px 40px" text="$l10n_eq_stat_agility"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="735px 0px" size="85px 40px" text="$l10n_eq_stat_temperament"/>
            <Text profile="rlMenu_tableHeaderLeftAligned" position="830px 0px" size="160px 40px" text="$l10n_eq_horses_col_status"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px"/>
        </GuiElement>

        <GuiElement profile="rlMenu_container" id="horsesBox" position="20px -115px" size="1020px 750px">
            <SmoothList profile="rlMenu_tableList" id="horseList" position="0px 0px" size="1000px 750px">
                <ListItem profile="rlMenu_tableListItem" name="horseRowTemplate" size="1000px 48px">
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="10px 0px" size="190px 48px" name="name" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="205px 0px" size="160px 48px" name="role" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="370px 0px" size="90px 48px" name="age" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="465px 0px" size="85px 48px" name="stamina" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="555px 0px" size="85px 48px" name="speed" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="645px 0px" size="85px 48px" name="agility" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="735px 0px" size="85px 48px" name="temperament" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="830px 0px" size="160px 48px" name="status" textLayoutMode="scrolling"/>
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="-5px 0px" size="12px 750px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 742px" dataElementId="horseList"/>
            </ThreePartBitmap>
        </GuiElement>

        <!-- The selected horse: label left, value at 190px. Filled from Lua, one line each. -->
        <GuiElement profile="rlMenu_container" id="horsePanel" position="1070px -70px" size="490px 800px">
            <GuiElement profile="rlMenu_container" position="0px 0px" size="490px 36px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="490px 36px" id="panelName" textSize="22px" textBold="true" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -36px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="490px 28px" id="panelSubtitle" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -74px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="185px 28px" id="lineLabel[1]" textLayoutMode="scrolling"/>
