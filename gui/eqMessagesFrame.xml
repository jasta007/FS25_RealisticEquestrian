<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
    eqMessagesFrame.xml
    The Messages tab of our own menu (EqMenu), for games without Realistic Livestock: our log of
    results, injuries, transport, hosting and sponsor news, newest first (EqMessages). With
    Realistic Livestock these lines go in its Messages tab instead.

    Part of Realistic Equestrian by Jasta007.
-->
<GUI name="EqMessagesFrame">
    <GuiElement profile="fs25_menuContainer">

        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" id="headerIcon" imageSliceId="eqMenu.messages"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="headerTitle" text="$l10n_eq_messages_title"/>
        </GuiElement>

        <GuiElement profile="rlMenu_container" position="20px -70px" size="1540px 40px">
            <Text profile="rlMenu_tableHeaderLeftAligned" position="10px 0px" size="200px 40px" text="$l10n_eq_messages_col_date"/>
            <Text profile="rlMenu_tableHeaderLeftAligned" position="215px 0px" size="180px 40px" text="$l10n_eq_messages_col_type"/>
            <Text profile="rlMenu_tableHeaderLeftAligned" position="400px 0px" size="1130px 40px" text="$l10n_eq_messages_col_message"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px"/>
        </GuiElement>

        <GuiElement profile="rlMenu_container" position="20px -115px" size="1560px 750px">
            <SmoothList profile="rlMenu_tableList" id="messageList" position="0px 0px" size="1540px 750px">
                <ListItem profile="rlMenu_tableListItem" name="messageRowTemplate" size="1540px 48px">
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="10px 0px" size="200px 48px" name="date" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="215px 0px" size="180px 48px" name="type" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="400px 0px" size="1130px 48px" name="text" textLayoutMode="scrolling"/>
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="-5px 0px" size="12px 750px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 742px" dataElementId="messageList"/>
            </ThreePartBitmap>
        </GuiElement>

        <Text profile="fs25_settingsMultiTextOptionTitle" id="emptyState"
              position="20px -450px" size="1540px 40px" textAlignment="center" visible="false"/>

        <Bitmap profile="rlMenu_tableSummary" id="summaryRow" position="20px -880px" size="1540px 40px">
            <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="1540px 40px" id="summaryText"/>
        </Bitmap>

    </GuiElement>
</GUI>
