<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
    eqStaffFrame.xml
    Realistic Equestrian's Staff tab inside RLRM's menu, laid out like the Events tab.

    Two tabs: Hire (the candidates on offer) and Your staff. Left, the people in a table; right,
    the selected person: their job, all ten skills, wage and, for your staff, Herdsman-style
    controls for who they work on and whether they work. Profiles are RLRM's
    (rlMenu_*) and the base game's (fs25_*), as on the Events tab.

    Part of Realistic Equestrian by Jasta007.
-->
<GUI name="EqStaffFrame">
    <GuiElement profile="fs25_menuContainer">

        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap profile="fs25_menuHeaderIcon" id="headerIcon" imageSliceId="eqMenu.staff"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" id="headerTitle" text="$l10n_eq_staff_title"/>
        </GuiElement>

        <BoxLayout profile="fs25_subCategorySelectorTabbedBox" id="subCategoryBox">
            <Button profile="fs25_subCategorySelectorTabbedTab" id="subCategoryTabs[1]"
                    text="$l10n_eq_staff_tab_hire" onClick="onClickHireTab">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
            <Button profile="fs25_subCategorySelectorTabbedTab" id="subCategoryTabs[2]"
                    text="$l10n_eq_staff_tab_staff" onClick="onClickStaffTab">
                <ThreePartBitmap profile="fs25_subCategorySelectorTabbedTabBg" name="background"/>
            </Button>
        </BoxLayout>
        <ThreePartBitmap profile="fs25_lineSeparatorTopHighlighted" position="0px -57px"/>
        <MultiTextOption profile="fs25_subCategorySelectorTabbed" id="subCategoryPaging"
                         position="0px -10px" onClick="onSubCategoryChanged"/>

        <!-- People table: the fourth column is Best skills on Hire, Works on on Your staff -->
        <GuiElement profile="rlMenu_container" id="peopleHeader" position="20px -120px" size="1000px 40px">
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="10px 0px"  size="190px 40px" text="$l10n_eq_staff_col_name"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="205px 0px" size="215px 40px" text="$l10n_eq_staff_col_job"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="425px 0px" size="130px 40px" text="$l10n_eq_staff_col_grade"/>
            <Text profile="rlMenu_tableHeaderLeftAligned"  position="560px 0px" size="290px 40px" id="peopleHeaderFourth" text="$l10n_eq_staff_col_best"/>
            <Text profile="rlMenu_tableHeaderRightAligned" position="855px 0px" size="135px 40px" text="$l10n_eq_staff_col_wage"/>
            <ThreePartBitmap profile="fs25_lineSeparatorBottom" position="0px 2px"/>
        </GuiElement>

        <GuiElement profile="rlMenu_container" id="peopleBox" position="20px -165px" size="1020px 700px">
            <SmoothList profile="rlMenu_tableList" id="peopleList" position="0px 0px" size="1000px 700px">
                <ListItem profile="rlMenu_tableListItem" name="personRowTemplate" size="1000px 48px">
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="10px 0px"  size="190px 48px" name="name" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="205px 0px" size="215px 48px" name="job" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="425px 0px" size="130px 48px" name="grade" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellLeftAligned"  position="560px 0px" size="290px 48px" name="fourth" textLayoutMode="scrolling"/>
                    <Text profile="rlMenu_tableRowCellRightAligned" position="855px 0px" size="135px 48px" name="wage"/>
                </ListItem>
            </SmoothList>
            <ThreePartBitmap profile="fs25_listSliderBox" position="-5px 0px" size="12px 700px" with="anchorTopRight">
                <Slider profile="fs25_listSlider" size="6px 692px" dataElementId="peopleList"/>
            </ThreePartBitmap>
        </GuiElement>

        <!-- The selected person: label left, value at 200px -->
        <GuiElement profile="rlMenu_container" id="personPanel" position="1070px -120px" size="490px 740px">
            <GuiElement profile="rlMenu_container" position="0px 0px" size="490px 36px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="490px 36px" id="panelName" textSize="22px" textBold="true" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -36px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="490px 28px" id="panelJob" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -74px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="skillLabel[1]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="skillValue[1]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -102px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="skillLabel[2]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="skillValue[2]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -130px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="skillLabel[3]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="skillValue[3]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -158px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="skillLabel[4]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="skillValue[4]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -194px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="skillLabel[5]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="skillValue[5]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -222px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="skillLabel[6]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="skillValue[6]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -250px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="skillLabel[7]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="skillValue[7]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -278px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="skillLabel[8]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="skillValue[8]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -314px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="skillLabel[9]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="skillValue[9]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -342px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="skillLabel[10]" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="skillValue[10]" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -382px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" text="$l10n_eq_staff_wage" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelWage" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -410px" size="490px 28px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="panelWorksOnLabel" textLayoutMode="scrolling"/>
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px 0px" size="290px 28px" id="panelWorksOn" textLayoutMode="scrolling"/>
            </GuiElement>
            <GuiElement profile="rlMenu_container" position="0px -438px" size="490px 112px">
                <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 28px" id="panelNoteLabel" textLayoutMode="scrolling"/>
                <!-- Duties wrap over up to four lines. -->
                <Text profile="rlMenu_tableRowCellLeftAligned" position="200px -4px" size="290px 108px" id="panelNote"
                      textVerticalAlignment="top" textMaxWidth="290px" textMaxNumLines="4" textLayoutMode="truncate"/>
            </GuiElement>

            <!-- Your staff only: who they work on and whether they work, as on RLRM's Herdsman
                 page. Stables and the role/horse checklist open RLRM's husbandry picker. -->
            <GuiElement profile="rlMenu_container" id="staffControls" position="0px -556px" size="490px 184px">
                <GuiElement profile="rlMenu_container" position="0px 0px" size="490px 42px">
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 42px" text="$l10n_eq_staff_status" textLayoutMode="scrolling"/>
                    <BinaryOption profile="fs25_settingsBinaryOption" id="statusToggle" position="0px 0px" size="290px 38px" onClick="onStatusChanged"/>
                </GuiElement>
                <GuiElement profile="rlMenu_container" position="0px -46px" size="490px 42px">
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 42px" text="$l10n_eq_staff_stables" textLayoutMode="scrolling"/>
                    <Button profile="rl_settingsButton" id="stablesButton" position="0px 0px" size="290px 38px" onClick="onClickStables">
                        <ThreePartBitmap profile="fs25_settingsButtonBg"/>
                    </Button>
                </GuiElement>
                <GuiElement profile="rlMenu_container" position="0px -92px" size="490px 42px">
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 42px" text="$l10n_eq_staff_col_worksOn" textLayoutMode="scrolling"/>
                    <BinaryOption profile="fs25_settingsBinaryOption" id="modeToggle" position="0px 0px" size="290px 38px" onClick="onModeChanged"/>
                </GuiElement>
                <GuiElement profile="rlMenu_container" position="0px -138px" size="490px 42px">
                    <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="195px 42px" id="pickLabel" textLayoutMode="scrolling"/>
                    <Button profile="rl_settingsButton" id="pickButton" position="0px 0px" size="290px 38px" onClick="onClickPick">
                        <ThreePartBitmap profile="fs25_settingsButtonBg"/>
                    </Button>
                </GuiElement>
            </GuiElement>
        </GuiElement>

        <Text profile="fs25_settingsMultiTextOptionTitle" id="emptyState"
              position="20px -450px" size="1000px 40px" textAlignment="center" visible="false"/>

        <Bitmap profile="rlMenu_tableSummary" id="summaryRow" position="20px -880px" size="1540px 40px">
            <Text profile="rlMenu_tableRowCellLeftAligned" position="0px 0px" size="1540px 40px" id="summaryText"/>
        </Bitmap>

    </GuiElement>
</GUI>
