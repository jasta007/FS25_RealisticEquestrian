<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="bleachers3x6.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="GIANTS Editor 64bit" version="10.0.14"/>
  </Asset>

  <Files>
    <File fileId="3" filename="$data/shaders/vehicleShader.xml"/>
    <File fileId="6" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_diffuse.png"/>
    <File fileId="5" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_normal.png"/>
    <File fileId="4" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_specular.png"/>
    <File fileId="11" filename="bleacherSponsor_diffuse.dds"/>
    <File fileId="1" filename="bleachers_diffuse.dds"/>
  </Files>


  <Materials>
    <Material name="bleachers" materialId="5" specularColor="0.301961 1 0">
      <Texture fileId="1"/>
    </Material>
    <Material name="eqBoardFace" materialId="7" customShaderId="3">
      <Custommap name="detailSpecular" fileId="4"/>
      <Custommap name="detailNormal" fileId="5"/>
      <Custommap name="detailDiffuse" fileId="6"/>
      <CustomParameter name="colorScale" value="0.8 0.8 0.78"/>
      <CustomParameter name="smoothnessScale" value="0.4"/>
      <CustomParameter name="metalnessScale" value="0"/>
    </Material>
    <Material name="eqSponsor1" materialId="6" specularColor="0.2 0 0" alphaBlending="true" customShaderId="3">
      <Texture fileId="11"/>
      <Custommap name="detailSpecular" fileId="4"/>
      <Custommap name="detailNormal" fileId="5"/>
      <Custommap name="detailDiffuse" fileId="6"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="bleachers3x6.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="bleachers3x6" nodeId="15">
      <Shape name="frame" shapeId="1" clipDistance="400" nodeId="16" castsShadows="true" receiveShadows="true" materialIds="5"/>
      <Shape name="eqBoardFace" shapeId="2" clipDistance="400" nodeId="17" castsShadows="false" receiveShadows="true" materialIds="7"/>
      <TransformGroup name="eqSponsors" nodeId="18">
        <Shape name="eqSponsor_1" shapeId="3" clipDistance="400" nodeId="19" castsShadows="false" receiveShadows="true" materialIds="6"/>
        <Shape name="eqSponsor_2" shapeId="4" clipDistance="400" nodeId="20" castsShadows="false" receiveShadows="true" materialIds="6"/>
        <Shape name="eqSponsor_3" shapeId="5" clipDistance="400" nodeId="21" castsShadows="false" receiveShadows="true" materialIds="6"/>
      </TransformGroup>
      <TransformGroup name="collision" nodeId="22">
        <Shape name="col" shapeId="6" static="true" collisionFilterGroup="0x1034" collisionFilterMask="0xfffffbff" density="0.01" nodeId="23" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="5"/>
      </TransformGroup>
    </TransformGroup>
  </Scene>

</i3D>
