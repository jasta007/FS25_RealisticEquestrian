<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="showJumpCavaletti.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="GIANTS Editor 64bit" version="10.0.14"/>
  </Asset>

  <Files>
    <File fileId="5" filename="$data/shaders/vehicleShader.xml"/>
    <File fileId="8" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_diffuse.png"/>
    <File fileId="7" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_normal.png"/>
    <File fileId="6" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_specular.png"/>
    <File fileId="4" filename="../xcJumps/xcFlags_diffuse.dds"/>
    <File fileId="1" filename="../xcJumps/xcPlanks_diffuse.dds"/>
    <File fileId="2" filename="../xcJumps/xcPlanks_normal.dds"/>
  </Files>


  <Materials>
    <Material name="sjFlags" materialId="9" specularColor="0.101961 1 0">
      <Texture fileId="4"/>
    </Material>
    <Material name="sjPaint" materialId="6" customShaderId="5">
      <Custommap name="detailSpecular" fileId="6"/>
      <Custommap name="detailNormal" fileId="7"/>
      <Custommap name="detailDiffuse" fileId="8"/>
      <CustomParameter name="colorScale" value="0.55 0.02 0.02"/>
      <CustomParameter name="smoothnessScale" value="0.55"/>
      <CustomParameter name="metalnessScale" value="0"/>
    </Material>
    <Material name="sjPlanks" materialId="11" specularColor="0.101961 1 0">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
    </Material>
    <Material name="sjWhite" materialId="5" customShaderId="5">
      <Custommap name="detailSpecular" fileId="6"/>
      <Custommap name="detailNormal" fileId="7"/>
      <Custommap name="detailDiffuse" fileId="8"/>
      <CustomParameter name="colorScale" value="0.8 0.8 0.78"/>
      <CustomParameter name="smoothnessScale" value="0.55"/>
      <CustomParameter name="metalnessScale" value="0"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="showJumpCavaletti.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="showJumpCavaletti" nodeId="21">
      <Shape name="planks" shapeId="1" clipDistance="300" nodeId="22" castsShadows="true" receiveShadows="true" materialIds="11"/>
      <Shape name="flags" shapeId="2" clipDistance="300" nodeId="23" castsShadows="true" receiveShadows="true" materialIds="9"/>
      <TransformGroup name="eqFlagsRed" translation="2.1 0 0" nodeId="24"/>
      <TransformGroup name="eqFlagsWhite" translation="-2.1 0 0" nodeId="25"/>
      <TransformGroup name="collision" nodeId="26">
        <Shape name="col" shapeId="3" static="true" collisionFilterGroup="0x1034" collisionFilterMask="0xfffffbff" density="0.01" nodeId="27" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="5"/>
        <Shape name="col" shapeId="4" static="true" collisionFilterGroup="0x1034" collisionFilterMask="0xfffffbff" density="0.01" nodeId="28" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="5"/>
      </TransformGroup>
      <TransformGroup name="eqPole1" translation="0 0.42 0" nodeId="29">
        <Shape name="eqPaint" shapeId="5" clipDistance="300" nodeId="30" castsShadows="true" receiveShadows="true" materialIds="6"/>
        <Shape name="white" shapeId="6" clipDistance="300" nodeId="31" castsShadows="true" receiveShadows="true" materialIds="5"/>
        <Shape name="ends" shapeId="7" clipDistance="300" nodeId="32" castsShadows="false" receiveShadows="true" materialIds="5"/>
        <Shape name="poleCol" shapeId="8" static="true" collisionFilterGroup="0x1034" collisionFilterMask="0xfffffbff" density="0.01" nodeId="33" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="5"/>
        <TransformGroup name="eqEnd" translation="1.75 0 0" nodeId="34"/>
      </TransformGroup>
    </TransformGroup>
  </Scene>

</i3D>
