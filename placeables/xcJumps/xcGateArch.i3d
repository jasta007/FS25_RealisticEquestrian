<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="xcGateArch.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="GIANTS Editor 64bit" version="10.0.14"/>
  </Asset>

  <Files>
    <File fileId="1" filename="$data/shaders/vehicleShader.xml"/>
    <File fileId="4" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_diffuse.png"/>
    <File fileId="3" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_normal.png"/>
    <File fileId="2" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_specular.png"/>
    <File fileId="9" filename="../bleachers/bleacherSponsor_diffuse.dds"/>
  </Files>


  <Materials>
    <Material name="eqSponsor" materialId="8" specularColor="0.2 0 0" alphaBlending="true" customShaderId="1">
      <Texture fileId="9"/>
    </Material>
    <Material name="gatePaint" materialId="6" customShaderId="1">
      <Custommap name="detailSpecular" fileId="2"/>
      <Custommap name="detailNormal" fileId="3"/>
      <Custommap name="detailDiffuse" fileId="4"/>
      <CustomParameter name="colorScale" value="0.005 0.02 0.1"/>
      <CustomParameter name="smoothnessScale" value="0.55"/>
      <CustomParameter name="metalnessScale" value="0"/>
    </Material>
    <Material name="gateWhite" materialId="5" customShaderId="1">
      <Custommap name="detailSpecular" fileId="2"/>
      <Custommap name="detailNormal" fileId="3"/>
      <Custommap name="detailDiffuse" fileId="4"/>
      <CustomParameter name="colorScale" value="0.8 0.8 0.78"/>
      <CustomParameter name="smoothnessScale" value="0.55"/>
      <CustomParameter name="metalnessScale" value="0"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="xcGateArch.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="xcGateArch" nodeId="21">
      <Shape name="frame" shapeId="1" clipDistance="600" nodeId="22" castsShadows="true" receiveShadows="true" materialIds="5"/>
      <Shape name="eqPaint" shapeId="2" clipDistance="600" nodeId="23" castsShadows="true" receiveShadows="true" materialIds="6"/>
      <Shape name="eqSponsor_2" shapeId="3" clipDistance="600" nodeId="24" castsShadows="false" receiveShadows="true" materialIds="8"/>
      <Shape name="eqSponsor_2b" shapeId="4" clipDistance="600" nodeId="25" castsShadows="false" receiveShadows="true" materialIds="8"/>
      <Shape name="eqSponsor_3" shapeId="5" clipDistance="600" nodeId="26" castsShadows="false" receiveShadows="true" materialIds="8"/>
      <Shape name="eqSponsor_3b" shapeId="6" clipDistance="600" nodeId="27" castsShadows="false" receiveShadows="true" materialIds="8"/>
      <Shape name="eqSponsor_1" shapeId="7" clipDistance="600" nodeId="28" castsShadows="false" receiveShadows="true" materialIds="8"/>
      <Shape name="eqSponsor_1b" shapeId="8" clipDistance="600" nodeId="29" castsShadows="false" receiveShadows="true" materialIds="8"/>
      <TransformGroup name="collision" nodeId="30">
        <Shape name="col" shapeId="9" static="true" collisionFilterGroup="0x1034" collisionFilterMask="0xfffffbff" density="0.01" nodeId="31" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="5"/>
        <Shape name="col" shapeId="10" static="true" collisionFilterGroup="0x1034" collisionFilterMask="0xfffffbff" density="0.01" nodeId="32" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="5"/>
        <Shape name="col" shapeId="11" static="true" collisionFilterGroup="0x1034" collisionFilterMask="0xfffffbff" density="0.01" nodeId="33" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="5"/>
      </TransformGroup>
    </TransformGroup>
  </Scene>

</i3D>
