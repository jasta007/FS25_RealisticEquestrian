  <Shapes externalShapesFile="xcCornerLog.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="xcCornerLog" nodeId="18">
      <Shape name="logs" shapeId="1" clipDistance="300" nodeId="19" castsShadows="true" receiveShadows="true" materialIds="7"/>
      <Shape name="logsB" shapeId="2" clipDistance="300" nodeId="20" castsShadows="true" receiveShadows="true" materialIds="8"/>
      <Shape name="ends" shapeId="3" clipDistance="300" nodeId="21" castsShadows="true" receiveShadows="true" materialIds="5"/>
      <Shape name="deck" shapeId="4" clipDistance="300" nodeId="22" castsShadows="true" receiveShadows="true" materialIds="6"/>
      <TransformGroup name="eqFlagsRed" translation="0.95 0 0" nodeId="23">
        <Shape name="pennantRed" shapeId="5" clipDistance="300" nodeId="24" castsShadows="true" receiveShadows="true" materialIds="9"/>
      </TransformGroup>
      <TransformGroup name="eqFlagsWhite" translation="-0.95 0 0" nodeId="25">
