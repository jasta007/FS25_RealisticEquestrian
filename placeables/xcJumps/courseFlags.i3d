<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="courseFlags.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="GIANTS Editor 64bit" version="10.0.14"/>
  </Asset>

  <Files>
    <File fileId="3" filename="$data/shaders/placeableShader.xml"/>
    <File fileId="1" filename="xcFlags_diffuse.dds"/>
  </Files>


  <Materials>
    <Material name="xcFlags" materialId="5" specularColor="0.101961 1 0">
      <Texture fileId="1"/>
    </Material>
    <Material name="xcGuideGold" materialId="6" specularColor="0.101961 1 0" customShaderId="3" customShaderVariation="vertexOffset">
      <Texture fileId="1"/>
      <Emissivemap fileId="1"/>
    </Material>
  </Materials>


  <PerInstanceMaterialParameters>
  </PerInstanceMaterialParameters>


  <Shapes externalShapesFile="courseFlags.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="gates" nodeId="14">
      <TransformGroup name="eqXcFlagWhite" nodeId="15">
        <Shape name="flag" shapeId="1" clipDistance="300" nodeId="16" castsShadows="true" receiveShadows="true" materialIds="5"/>
        <Shape name="col" shapeId="2" static="true" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" density="0.01" nodeId="17" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="5"/>
      </TransformGroup>
      <TransformGroup name="eqXcFlagRed" nodeId="18">
        <Shape name="flag" shapeId="3" clipDistance="300" nodeId="19" castsShadows="true" receiveShadows="true" materialIds="5"/>
        <Shape name="col" shapeId="2" static="true" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" density="0.01" nodeId="20" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="5"/>
      </TransformGroup>
    </TransformGroup>
    <TransformGroup name="poles" nodeId="21">
      <TransformGroup name="eqXcNoPole" nodeId="22"/>
    </TransformGroup>
    <TransformGroup name="panels" nodeId="23">
      <TransformGroup name="eqXcLine" nodeId="24">
        <TransformGroup name="eqXcGuide" nodeId="25">
          <Shape name="line" shapeId="4" clipDistance="300" nodeId="26" castsShadows="false" receiveShadows="true" materialIds="6"/>
        </TransformGroup>
        <Shape name="col" shapeId="5" static="true" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" density="0.01" nodeId="27" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="5"/>
      </TransformGroup>
    </TransformGroup>
  </Scene>

</i3D>
