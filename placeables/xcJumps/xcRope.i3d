        <Shape name="eqCrowdBox" shapeId="8" clipDistance="300" nodeId="38" castsShadows="false" receiveShadows="true" materialIds="6"/>
        <Shape name="col" shapeId="4" static="true" collisionFilterGroup="0x3e" collisionFilterMask="0xfffffbff" density="0.01" nodeId="39" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="5"/>
