  <Materials>
    <Material name="xcFlags" materialId="8" specularColor="0.101961 1 0">
      <Texture fileId="6"/>
    </Material>
    <Material name="xcLogEnd" materialId="5" specularColor="0.101961 1 0">
      <Texture fileId="3"/>
    </Material>
    <Material name="xcPeeled" materialId="7" specularColor="0.101961 1 0">
      <Texture fileId="1"/>
    </Material>
    <Material name="xcPlanks" materialId="6" specularColor="0.101961 1 0">
      <Texture fileId="4"/>
      <Normalmap fileId="5"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="xcRollTopQuarter.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="xcRollTopQuarter" nodeId="16">
      <Shape name="logs" shapeId="1" clipDistance="300" nodeId="17" castsShadows="true" receiveShadows="true" materialIds="7"/>
      <Shape name="ends" shapeId="2" clipDistance="300" nodeId="18" castsShadows="true" receiveShadows="true" materialIds="5"/>
      <Shape name="frames" shapeId="3" clipDistance="300" nodeId="19" castsShadows="true" receiveShadows="true" materialIds="6"/>
      <TransformGroup name="eqFlagsRed" translation="2 0 0" nodeId="20">
        <Shape name="pennantRed" shapeId="4" clipDistance="300" nodeId="21" castsShadows="true" receiveShadows="true" materialIds="8"/>
      </TransformGroup>
      <TransformGroup name="eqFlagsWhite" translation="-2 0 0" nodeId="22">
        <Shape name="pennantWhite" shapeId="5" clipDistance="300" nodeId="23" castsShadows="true" receiveShadows="true" materialIds="8"/>
      </TransformGroup>
      <TransformGroup name="collision" nodeId="24">
        <Shape name="col" shapeId="6" static="true" collisionFilterGroup="0x1034" collisionFilterMask="0xfffffbff" density="0.01" nodeId="25" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="5"/>
