<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="xcRollTopQuarter.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="GIANTS Editor 64bit" version="10.0.14"/>
  </Asset>

  <Files>
    <File fileId="6" filename="xcFlags_diffuse.dds"/>
    <File fileId="3" filename="xcLogEnd_diffuse.dds"/>
    <File fileId="1" filename="xcPeeled_diffuse.dds"/>
    <File fileId="4" filename="xcPlanks_diffuse.dds"/>
    <File fileId="5" filename="xcPlanks_normal.dds"/>
