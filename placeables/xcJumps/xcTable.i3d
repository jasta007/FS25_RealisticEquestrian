      <Shape name="deck" shapeId="2" clipDistance="300" nodeId="22" castsShadows="true" receiveShadows="true" materialIds="8"/>
      <Shape name="posts" shapeId="3" clipDistance="300" nodeId="23" castsShadows="true" receiveShadows="true" materialIds="7"/>
