<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="xcLogPile.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="GIANTS Editor 64bit" version="10.0.14"/>
  </Asset>

  <Files>
    <File fileId="1" filename="xcBarkA_diffuse.dds"/>
    <File fileId="2" filename="xcBarkA_normal.dds"/>
    <File fileId="4" filename="xcBarkB_diffuse.dds"/>
    <File fileId="5" filename="xcBarkB_normal.dds"/>
    <File fileId="7" filename="xcFlags_diffuse.dds"/>
    <File fileId="6" filename="xcLogEnd_diffuse.dds"/>
  </Files>


  <Materials>
    <Material name="xcBarkA" materialId="162" specularColor="0.101961 1 0">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
    </Material>
    <Material name="xcBarkB" materialId="163" specularColor="0.101961 1 0">
      <Texture fileId="4"/>
      <Normalmap fileId="5"/>
    </Material>
    <Material name="xcFlags" materialId="165" specularColor="0.101961 1 0">
      <Texture fileId="7"/>
    </Material>
    <Material name="xcLogEnd" materialId="164" specularColor="0.101961 1 0">
      <Texture fileId="6"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="xcLogPile.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="xcLogPile" nodeId="172">
      <Shape name="logsA" shapeId="1" clipDistance="300" nodeId="173" castsShadows="true" receiveShadows="true" materialIds="162"/>
      <Shape name="logsB" shapeId="2" clipDistance="300" nodeId="174" castsShadows="true" receiveShadows="true" materialIds="163"/>
      <Shape name="logEnds" shapeId="3" clipDistance="300" nodeId="175" castsShadows="true" receiveShadows="true" materialIds="164"/>
      <Shape name="flags" shapeId="4" clipDistance="300" nodeId="176" castsShadows="true" receiveShadows="true" materialIds="165"/>
      <TransformGroup name="eqFlagsRed" translation="2.58 0 0" nodeId="177"/>
      <TransformGroup name="eqFlagsWhite" translation="-2.58 0 0" nodeId="178"/>
      <TransformGroup name="collision" nodeId="179">
        <Shape name="col" shapeId="5" static="true" collisionFilterGroup="0x1034" collisionFilterMask="0xfffffbff" density="0.01" nodeId="180" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="162"/>
      </TransformGroup>
    </TransformGroup>
  </Scene>

</i3D>
