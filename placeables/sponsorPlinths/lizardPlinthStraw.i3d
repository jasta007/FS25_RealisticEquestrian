      <TransformGroup name="logs" nodeId="35">
        <Shape name="logBark" shapeId="4" clipDistance="600" nodeId="36" castsShadows="true" receiveShadows="true" materialIds="6"/>
        <Shape name="logEnds" shapeId="5" clipDistance="600" nodeId="37" castsShadows="true" receiveShadows="true" materialIds="7"/>
      </TransformGroup>
      <TransformGroup name="lizard" translation="0 0.75 2.35" nodeId="38">
