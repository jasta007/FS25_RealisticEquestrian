        <Shape name="palletTrigger" shapeId="12" kinematic="true" compound="true" trigger="true" collisionFilterGroup="0x20000000" collisionFilterMask="0x10000" clipDistance="600" nodeId="47" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="11"/>
