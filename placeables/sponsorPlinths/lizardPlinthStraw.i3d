      <Normalmap fileId="2"/>
    </Material>
    <Material name="trigger" materialId="11" diffuseColor="0.501961 0.501961 0.501961 1">
    </Material>
  </Materials>


  <Shapes externalShapesFile="lizardPlinthStraw.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="lizardPlinthStraw" nodeId="29">
      <TransformGroup name="site" nodeId="30">
        <Shape name="stakes" shapeId="1" clipDistance="600" nodeId="31" castsShadows="true" receiveShadows="true" materialIds="8"/>
      </TransformGroup>
      <TransformGroup name="mound" nodeId="32">
