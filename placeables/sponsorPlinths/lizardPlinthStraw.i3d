        <Shape name="collision" shapeId="3" static="true" collisionFilterGroup="0x1037" collisionFilterMask="0xfffffbff" density="0.01" clipDistance="600" nodeId="34" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="11"/>
