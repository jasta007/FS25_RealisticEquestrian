    </Material>
    <Material name="lizardBark" materialId="6" specularColor="0.101961 1 0">
      <Texture fileId="8"/>
      <Normalmap fileId="9"/>
    </Material>
    <Material name="lizardBoardFace" materialId="9" diffuseColor="0.0313726 0.0313726 0.0313726 1" specularColor="0.2 1 0">
