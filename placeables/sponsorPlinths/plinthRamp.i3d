<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="plinthRamp.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="GIANTS Editor 64bit" version="10.0.14"/>
  </Asset>

  <Files>
    <File fileId="3" filename="$data/shaders/vehicleShader.xml"/>
    <File fileId="6" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_diffuse.png"/>
    <File fileId="5" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_normal.png"/>
    <File fileId="4" filename="$data/shared/detailLibrary/calibrated/calibratedPaint_specular.png"/>
    <File fileId="11" filename="../bleachers/bleacherSponsor_diffuse.dds"/>
    <File fileId="1" filename="plinthStone_diffuse.dds"/>
  </Files>


  <Materials>
    <Material name="eqSponsor" materialId="8" specularColor="0.2 1 0" alphaBlending="true">
      <Texture fileId="11"/>
    </Material>
    <Material name="plinthPaint" materialId="6" customShaderId="3">
      <Custommap name="detailSpecular" fileId="4"/>
      <Custommap name="detailNormal" fileId="5"/>
      <Custommap name="detailDiffuse" fileId="6"/>
      <CustomParameter name="colorScale" value="0.04 0.3 0.06"/>
      <CustomParameter name="smoothnessScale" value="0.55"/>
      <CustomParameter name="metalnessScale" value="0"/>
    </Material>
    <Material name="plinthStone" materialId="5" specularColor="0.14902 1 0">
      <Texture fileId="1"/>
    </Material>
    <Material name="plinthWhite" materialId="7" customShaderId="3">
      <Custommap name="detailSpecular" fileId="4"/>
      <Custommap name="detailNormal" fileId="5"/>
      <Custommap name="detailDiffuse" fileId="6"/>
      <CustomParameter name="colorScale" value="0.8 0.8 0.78"/>
      <CustomParameter name="smoothnessScale" value="0.55"/>
      <CustomParameter name="metalnessScale" value="0"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="plinthRamp.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="plinthRamp" nodeId="17">
      <Shape name="stone" shapeId="1" clipDistance="600" nodeId="18" castsShadows="true" receiveShadows="true" materialIds="5"/>
      <Shape name="eqPaint" shapeId="2" clipDistance="600" nodeId="19" castsShadows="true" receiveShadows="true" materialIds="6"/>
      <Shape name="eqBoardFace" shapeId="3" clipDistance="600" nodeId="20" castsShadows="true" receiveShadows="true" materialIds="7"/>
      <Shape name="eqSponsor_1" shapeId="4" clipDistance="600" nodeId="21" castsShadows="false" receiveShadows="true" materialIds="8"/>
      <TransformGroup name="collision" nodeId="22">
        <Shape name="col" shapeId="5" static="true" collisionFilterGroup="0x1034" collisionFilterMask="0xfffffbff" density="0.01" nodeId="23" castsShadows="false" receiveShadows="false" nonRenderable="true" materialIds="5"/>
      </TransformGroup>
    </TransformGroup>
  </Scene>

</i3D>
