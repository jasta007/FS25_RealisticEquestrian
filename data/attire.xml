                <color primary="0.80 0.72 0.55 1" secondary="0.80 0.72 0.55 1"/>
                <color primary="0.55 0.55 0.55 1" secondary="0.55 0.55 0.55 1"/>
                <color primary="0.020 0.020 0.022 1" secondary="0.020 0.020 0.022 1"/>
                <color primary="0.008 0.012 0.040 1" secondary="0.008 0.012 0.040 1"/>
            </colors>
        </bottom>
        <gloves name="eqDressageGloves" filename="$dataS/character/playerM/gloves/glovesMechanic.i3d" node="1|0|0" attachPoint="geo" extent="over" colorable="2" defaultPrimaryIndex="1" iconFilename="data/attire/gloves_icon.dds" eqDiffuse="data/attire/plainCloth_diffuse.dds" eqNormal="data/attire/flat_normal.dds">
            <hidesBodypart name="hands"/>
