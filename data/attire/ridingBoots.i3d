<?xml version="1.0" encoding="iso-8859-1"?>

<i3D name="ridingBoots.i3d" version="1.6" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://i3d.giants.ch/schema/i3d-1.6.xsd">
  <Asset>
    <Export program="GIANTS Editor 64bit" version="10.0.14"/>
  </Asset>

  <Files>
    <File fileId="1" filename="ridingBoots_diffuse.dds"/>
    <File fileId="2" filename="ridingBoots_normal.dds"/>
  </Files>


  <Materials>
    <Material name="eqRidingBoots" materialId="5" specularColor="0.54902 1 0">
      <Texture fileId="1"/>
      <Normalmap fileId="2"/>
    </Material>
  </Materials>


  <Shapes externalShapesFile="ridingBoots.i3d.shapes">
  </Shapes>

  <Scene>
    <TransformGroup name="eqBootSkeleton" nodeId="11"/>
    <TransformGroup name="eqRidingBoots" nodeId="12">
      <TransformGroup name="eqBootShaftL" nodeId="13">
        <Shape name="eqBootShaftLShape" shapeId="1" clipDistance="150" nodeId="14" castsShadows="true" receiveShadows="true" materialIds="5"/>
      </TransformGroup>
      <TransformGroup name="eqBootFootL" nodeId="15">
        <Shape name="eqBootFootLShape" shapeId="2" clipDistance="150" nodeId="16" castsShadows="true" receiveShadows="true" materialIds="5"/>
      </TransformGroup>
      <TransformGroup name="eqBootShaftR" nodeId="17">
        <Shape name="eqBootShaftRShape" shapeId="3" clipDistance="150" nodeId="18" castsShadows="true" receiveShadows="true" materialIds="5"/>
      </TransformGroup>
      <TransformGroup name="eqBootFootR" nodeId="19">
        <Shape name="eqBootFootRShape" shapeId="4" clipDistance="150" nodeId="20" castsShadows="true" receiveShadows="true" materialIds="5"/>
      </TransformGroup>
    </TransformGroup>
  </Scene>

</i3D>
